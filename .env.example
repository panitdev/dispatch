# PostgreSQL connection string
DATABASE_URL=postgres://postgres:password@localhost:5432/dispatch

# Externally managed Ory Kratos endpoints
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_BROWSER_URL=http://localhost:4433

# Browser-reachable Dispatch API origin used for OAuth return_to URLs
DISPATCH_PUBLIC_URL=http://localhost:8080

# Externally managed Ory Hydra endpoints
HYDRA_PUBLIC_URL=http://localhost:4444
HYDRA_ADMIN_URL=http://localhost:4445

# API server
API_PORT=8080

# Allowed CORS origin (your frontend URL)
FRONTEND_ORIGIN=http://localhost:3000

# Snowflake ID generator node identity (0–31 each)
SNOWFLAKE_MACHINE_ID=1
SNOWFLAKE_NODE_ID=1
